# OpenClaw Quant Research
# Copy this file to `.env` and adjust values for your machine.
# Never commit `.env`.

# Core environment
APP_ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quant_research
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_dev_password
DATABASE_URL=postgresql://quant:quant_dev_password@localhost:5432/quant_research

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Service ports
INGESTION_PORT=8001
RAG_PORT=8002
QUANT_PORT=8003
RISK_PORT=8004
PLANNER_PORT=8005
REPORT_PORT=8006
CRITIC_PORT=8007

# Data directories
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
MARKET_DATA_DIR=./data/market
FUNDAMENTAL_DATA_DIR=./data/financials
REPORTS_DIR=./data/reports

# Quant / fundamentals
ENABLE_LIVE_FUNDAMENTAL_FETCH=1
FUNDAMENTAL_CACHE_HOURS=168
INDUSTRY_COMPARISON_MAX_PEERS=8
AKSHARE_DELAY=1.0

# Optional model providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VOYAGE_API_KEY=
COHERE_API_KEY=

# Optional Feishu / OpenClaw runtime integration
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ADMIN_USER_ID=
