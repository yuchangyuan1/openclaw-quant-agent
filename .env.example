# ===================================================
# 量化投研 Multi-Agent 系统 — 环境变量模板
# 复制此文件为 .env 并填入真实值，切勿将 .env 提交到 git
# ===================================================

# --- 数据库 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quant_research
POSTGRES_USER=quant
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://quant:your_postgres_password_here@localhost:5432/quant_research

# --- 向量库 ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- AI 模型 API Keys ---
# OpenAI (gpt-5.4-mini)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Voyage AI (voyage-finance-2 embedding)
VOYAGE_API_KEY=pa-your_voyage_key_here

# Cohere (rerank-2.5)
COHERE_API_KEY=your_cohere_key_here

# --- 飞书 Bot ---
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
# 管理员飞书 User ID（用于发送系统告警）
FEISHU_ADMIN_USER_ID=your_admin_user_id_here

# --- 服务端口 ---
INGESTION_PORT=8001
RAG_PORT=8002
QUANT_PORT=8003
RISK_PORT=8004
PLANNER_PORT=8005
REPORT_PORT=8006
CRITIC_PORT=8007

# --- 数据路径 ---
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
MARKET_DATA_DIR=./data/market
REPORTS_DIR=./data/reports

# --- 日志级别 ---
LOG_LEVEL=INFO

# --- 环境标识 ---
# development | staging | production
APP_ENV=development
