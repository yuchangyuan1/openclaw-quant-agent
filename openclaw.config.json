{
  "agents": {
    "defaults": {
      "model": "gpt-5.4-mini",
      "tools": {
        "profile": "coding"
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 6,
        "maxConcurrent": 8,
        "runTimeoutSeconds": 900
      }
    },
    "list": [
      {
        "id": "planner",
        "default": true,
        "agentDir": "./openclaw/workspaces/planner",
        "workspace": "~/.openclaw/workspaces/quant-research/planner"
      },
      {
        "id": "knowledge",
        "agentDir": "./openclaw/workspaces/knowledge",
        "workspace": "~/.openclaw/workspaces/quant-research/knowledge",
        "tools": {
          "allow": ["read", "web_search", "web_fetch", "sessions_history"],
          "deny": ["exec", "apply_patch"]
        }
      },
      {
        "id": "quant",
        "agentDir": "./openclaw/workspaces/quant",
        "workspace": "~/.openclaw/workspaces/quant-research/quant",
        "sandbox": {
          "mode": "all",
          "scope": "agent"
        }
      },
      {
        "id": "risk",
        "agentDir": "./openclaw/workspaces/risk",
        "workspace": "~/.openclaw/workspaces/quant-research/risk",
        "sandbox": {
          "mode": "all",
          "scope": "agent"
        }
      },
      {
        "id": "report",
        "agentDir": "./openclaw/workspaces/report",
        "workspace": "~/.openclaw/workspaces/quant-research/report"
      },
      {
        "id": "critic",
        "agentDir": "./openclaw/workspaces/critic",
        "workspace": "~/.openclaw/workspaces/quant-research/critic",
        "tools": {
          "allow": ["read", "sessions_history"],
          "deny": ["exec", "write", "apply_patch"]
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "planner",
      "match": {
        "channel": "feishu",
        "accountId": "default"
      }
    }
  ],
  "channels": {
    "feishu": {
      "enabled": true,
      "defaultAccount": "default",
      "accounts": {
        "default": {
          "appId": "${FEISHU_APP_ID}",
          "appSecret": "${FEISHU_APP_SECRET}",
          "name": "Quant Research Assistant"
        }
      },
      "streaming": true,
      "blockStreaming": true
    }
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 1,
    "timezone": "Asia/Shanghai",
    "jobs": [
      {
        "id": "daily_report",
        "schedule": "15 8 * * 1-5",
        "agentId": "planner",
        "message": "Scheduled task: generate today's quant research daily report for {{date}}.",
        "description": "Weekday 08:15 daily report generation"
      },
      {
        "id": "weekly_report",
        "schedule": "0 8 * * 1",
        "agentId": "planner",
        "message": "Scheduled task: generate this week's quant research weekly report for {{week_start}} to {{week_end}}.",
        "description": "Monday 08:00 weekly report generation"
      },
      {
        "id": "evening_data_fetch",
        "schedule": "30 16 * * 1-5",
        "agentId": "planner",
        "message": "Scheduled task: run target-pool end-of-day incremental ingestion and refresh the Quant data store.",
        "description": "Weekday 16:30 end-of-day ingestion"
      },
      {
        "id": "morning_target_pool_sync",
        "schedule": "35 8 * * 1-5",
        "agentId": "planner",
        "message": "Scheduled task: run target-pool morning incremental ingestion before market open.",
        "description": "Weekday 08:35 target-pool morning sync"
      },
      {
        "id": "midday_target_pool_sync",
        "schedule": "35 12 * * 1-5",
        "agentId": "planner",
        "message": "Scheduled task: run target-pool midday incremental ingestion to backfill newly published announcements and news.",
        "description": "Weekday 12:35 target-pool midday sync"
      }
    ]
  },
  "services": {
    "ingestion": {
      "baseUrl": "http://localhost:8001",
      "timeoutSeconds": 30
    },
    "rag": {
      "baseUrl": "http://localhost:8002",
      "timeoutSeconds": 10
    },
    "quant": {
      "baseUrl": "http://localhost:8003",
      "timeoutSeconds": 30
    },
    "risk": {
      "baseUrl": "http://localhost:8004",
      "timeoutSeconds": 30
    },
    "planner": {
      "baseUrl": "http://localhost:8005",
      "timeoutSeconds": 20
    },
    "report": {
      "baseUrl": "http://localhost:8006",
      "timeoutSeconds": 20
    },
    "critic": {
      "baseUrl": "http://localhost:8007",
      "timeoutSeconds": 20
    }
  }
}
